{
  agents: {
    defaults: {
      heartbeat: {
        // debug: 10m. Production can go back to 30m and 08:00–22:00.
        every: "10m",
        target: "openclaw-weixin",
        lightContext: false,
        activeHours: { start: "00:00", end: "23:59", timezone: "Asia/Tokyo" }
      }
    }
  }
}
